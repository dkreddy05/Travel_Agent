# ─────────────────────────────────────────────────────────
#  WanderAI v2.0 — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Flask ──────────────────────────────────────────────────
# For production set FLASK_ENV=production and FLASK_DEBUG=False
FLASK_ENV=production
FLASK_SECRET_KEY=change-me-to-a-random-32-char-string
FLASK_DEBUG=False
PORT=5000
APP_URL=http://localhost:5000

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://wanderai:wanderai@localhost:5432/wanderai

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-jwt-secret-key

# ── IBM watsonx.ai ─────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
GRANITE_MODEL_ID=meta-llama/llama-3-3-70b-instruct
AI_FALLBACK_MODEL=

# AI generation settings
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# ── Vector DB (Qdrant) ─────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email ──────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=WanderAI <noreply@wanderai.app>

# ── External Tool APIs ─────────────────────────────────────
OPENWEATHER_API_KEY=
EXCHANGERATE_API_KEY=
FOURSQUARE_API_KEY=

# ── Grafana ────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me-grafana-password

# ── Observability ──────────────────────────────────────────
SENTRY_DSN=
